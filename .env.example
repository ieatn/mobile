# Supabase — project "testing" (https://supabase.com/dashboard/project/pahjwgiuvjmqhutwnblx)
EXPO_PUBLIC_SUPABASE_URL=https://YOUR_PROJECT_REF.supabase.co
EXPO_PUBLIC_SUPABASE_ANON_KEY=your_anon_or_publishable_key

# Auth setup (dashboard)
# 1. Enable Google provider: Authentication → Providers → Google
# 2. Add redirect URLs: Authentication → URL Configuration
#    - mobile://**
#    - exp://127.0.0.1:8081 (Expo Go dev)
#    - http://localhost:8081 (web dev)
# 3. Optional: disable "Confirm email" while testing email sign-up

# AI (Gemini key on Supabase only — NOT in this file)
# Install CLI: brew install supabase/tap/supabase
# Then: supabase login && supabase link --project-ref YOUR_REF
#       supabase secrets set GEMINI_API_KEY=your_google_ai_studio_key
#       supabase functions deploy ai-notes
